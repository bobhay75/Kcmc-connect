        "/* KCMC_VISITOR_WELCOME_20261008 END */\n\n/* KCMC_BLUE_FISH_MENU_20261009: owner-requested public presentation. */\nbody[data-office-email]{background:#0d2235}\n.topbar{background:rgba(13,34,53,.96)}\n.topbar .inner{justify-content:flex-start}\n.topbar .fish-menu summary{width:76px;min-height:56px;padding:0 7px 0 0;gap:0;background:#0d2235;border-color:#49677c;border-radius:14px}\n.fish-menu summary img{display:block;width:56px;height:56px;border-radius:12px}\n.fish-menu summary:after{margin-left:0;font-size:.75rem;color:#b9dce9}\n.fish-menu nav{top:100%;left:0;right:auto;width:300px;max-width:calc(100vw - 30px);max-height:calc(100dvh - 92px);border-color:#49677c}\n.fish-menu .menu-home{padding:14px 12px;margin-bottom:6px;border-bottom:1px solid #49677c;border-radius:9px 9px 0 0}\n.menu-home strong,.menu-home small{display:block}\n.menu-home strong{font-size:.95rem;letter-spacing:.04em}\n.menu-home small{font-size:.72rem;color:#b8ccd8;white-space:normal}\n.fish-menu nav [data-install-app]{display:block;white-space:normal}\n.family-welcome{background:#0d2235}\n.news-feature{background:#14334b;color:#eef5f8;border:1px solid #49677c}\n.news-feature .eyebrow{color:#b9dce9}\n.news-feature p{color:#c7d5dd}\n/* KCMC_BLUE_FISH_MENU_20261009 END */\n"
