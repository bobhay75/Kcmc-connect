Options -Indexes

<FilesMatch "^(config(?:\.example)?\.php|SETUP-CREDENTIALS\.txt|DEPLOY\.md|VERSION(?:\.txt)?|RELEASE-MANIFEST\.txt|.*\.bundle)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Place-specific KCMC imagery must depict the real Kimberling City / Table Rock Lake location.
  # Temporary verified source: 2024 Kimberling City Bridge photo by Avalon1101, CC0/public domain.
  RewriteRule ^assets/visuals/table-rock-bridge-v2\.webp$ https://upload.wikimedia.org/wikipedia/commons/d/d0/Kimberling_City%2C_Missouri_Bridge.jpg [R=302,L,NE]
  RewriteRule ^assets/visuals/cross-over-lake\.jpg$ https://upload.wikimedia.org/wikipedia/commons/d/d0/Kimberling_City%2C_Missouri_Bridge.jpg [R=302,L,NE]
  RewriteRule ^(?:data|backups)(?:/|$) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
